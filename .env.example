# Gemini API — 캐릭터 일러스트 자동 생성. https://aistudio.google.com 에서 발급.
GEMINI_API_KEY=

# 타입캐스트(Typecast) TTS — 대시보드 > 개발자센터에서 발급, 절대 커밋 금지
TYPECAST_API_KEY=

# Pexels — 실물 사진 자동 소싱. https://www.pexels.com/api 에서 무료 발급
PEXELS_API_KEY=

# Unsplash — 실물 사진 자동 소싱(Pexels 보완용). https://unsplash.com/developers 에서 무료 발급
UNSPLASH_ACCESS_KEY=

# Pixabay — 배경음악(BGM) 자동 소싱. https://pixabay.com/api/docs/ 에서 무료 발급.
# 공식 문서엔 음악 전용 엔드포인트가 잘 안 보이지만 api.pixabay.com/api/audio/ 가
# 실제로 살아있음(2026-08-05 curl로 직접 확인) — Pixabay License라 상업적 이용에
# 저작자 표시도 필요 없음.
PIXABAY_API_KEY=

# 유튜브 쇼츠 자동 업로드(한국어 채널, 기본) — Google Cloud Console에서 OAuth
# 클라이언트(데스크톱 앱) 발급 후 CLIENT_ID/SECRET을 채우고,
# lib/youtube_auth_setup.py를 한 번 실행해서 REFRESH_TOKEN을 받아 채운다.
# 절대 커밋 금지.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# 글로벌 채널(언어별, data/global_channels.json 참고) — 채널마다 별도 GCP
# 프로젝트/OAuth 클라이언트라 변수도 채널 code 접두사로 따로 둔다. 예시(영어):
# lib/youtube_auth_setup.py --channel en 실행해서 REFRESH_TOKEN 발급.
# YOUTUBE_EN_CLIENT_ID=
# YOUTUBE_EN_CLIENT_SECRET=
# YOUTUBE_EN_REFRESH_TOKEN=
