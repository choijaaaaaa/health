# Gemini API — 캐릭터 일러스트 자동 생성. https://aistudio.google.com 에서 발급.
GEMINI_API_KEY=

# Fish Audio TTS(2026-08-14, Typecast 대체) — https://fish.audio 계정 설정에서
# 발급. 절대 커밋 금지. lib/fish_tts.py가 사용, 보이스 풀은
# data/fish_audio_voices{,_en,_ja}.json.
FISH_AUDIO_API_KEY=

# Pexels — 실물 사진 자동 소싱. https://www.pexels.com/api 에서 무료 발급
PEXELS_API_KEY=

# Unsplash — 실물 사진 자동 소싱(Pexels 보완용). https://unsplash.com/developers 에서 무료 발급
UNSPLASH_ACCESS_KEY=

# Pixabay — 배경음악(BGM) 자동 소싱. https://pixabay.com/api/docs/ 에서 무료 발급.
# 공식 문서엔 음악 전용 엔드포인트가 잘 안 보이지만 api.pixabay.com/api/audio/ 가
# 실제로 살아있음(2026-08-05 curl로 직접 확인) — Pixabay License라 상업적 이용에
# 저작자 표시도 필요 없음.
PIXABAY_API_KEY=

# 유튜브 쇼츠 자동 업로드(한국어 채널, 기본) — Google Cloud Console에서 OAuth
# 클라이언트(데스크톱 앱) 발급 후 CLIENT_ID/SECRET을 채우고,
# lib/youtube_auth_setup.py를 한 번 실행해서 REFRESH_TOKEN을 받아 채운다.
# 절대 커밋 금지.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# 글로벌 채널(언어별, data/global_channels.json 참고) — 채널마다 별도 GCP
# 프로젝트/OAuth 클라이언트라 변수도 채널 code 접두사로 따로 둔다. 예시(영어):
# lib/youtube_auth_setup.py --channel en 실행해서 REFRESH_TOKEN 발급.
# YOUTUBE_EN_CLIENT_ID=
# YOUTUBE_EN_CLIENT_SECRET=
# YOUTUBE_EN_REFRESH_TOKEN=

# Supabase — Personal Access Token(계정 전체 Management API 권한, 프로젝트
# 단위 anon/service key가 아님). https://supabase.com/dashboard/account/tokens
# 에서 발급. 절대 커밋 금지, 브라우저(index.html 등 클라이언트 코드)에 노출
# 금지 — 서버/CLI/Claude Code 실행 환경에서만 사용.
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
SUPABASE_PROJECT_REF=
SUPABASE_URL=
# anon key는 index.html(브라우저)에 그대로 들어가는 공개 키 — RLS 정책이
# 실제 접근 제어를 담당하므로 이 값 자체는 노출돼도 된다.
SUPABASE_ANON_KEY=
# service_role key는 RLS를 우회하는 전체 권한 키 — 절대 브라우저/커밋 금지,
# lib/dashboard.py·lib/youtube_upload.py 등 서버 측 스크립트에서만 사용.
SUPABASE_SERVICE_ROLE_KEY=

# mission-control(../mission-control, 통합 모니터링 대시보드) 이슈 수집 API —
# lib/mission_control_log.py가 사용. 로컬에 mission-control을 안 띄워둔
# 세션이 대부분이라 비워두면(둘 중 하나라도 없으면) 조용히 보고를 건너뛴다,
# 필수 아님. URL 예: http://localhost:3011 또는 배포 URL.
MISSION_CONTROL_INGEST_URL=
MISSION_CONTROL_INGEST_SECRET=
