# Gemini API — 캐릭터 일러스트 자동 생성. https://aistudio.google.com 에서 발급.
GEMINI_API_KEY=

# 타입캐스트(Typecast) TTS — 대시보드 > 개발자센터에서 발급, 절대 커밋 금지
TYPECAST_API_KEY=

# Pexels — 실물 사진 자동 소싱. https://www.pexels.com/api 에서 무료 발급
PEXELS_API_KEY=

# Unsplash — 실물 사진 자동 소싱(Pexels 보완용). https://unsplash.com/developers 에서 무료 발급
UNSPLASH_ACCESS_KEY=

# 유튜브 쇼츠 자동 업로드 — Google Cloud Console에서 OAuth 클라이언트(데스크톱 앱)
# 발급 후 CLIENT_ID/SECRET을 채우고, lib/youtube_auth_setup.py를 한 번 실행해서
# REFRESH_TOKEN을 받아 채운다. 절대 커밋 금지.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
