    {
      "name": "Cerveja",
      "char_file": "맥주_illust.jpg",
      "body": ["Relaxa esse músculo", "e aumenta o ácido no estômago", "", "De estômago vazio,", "o efeito é ainda pior"]
    },
    {
      "name": "Cerveja — troque por isso",
      "char_file": "맥주_illust.jpg",
      "body": ["Troque um copo por água", "de vez em quando", "", "Ajuda a diluir o ácido", "e reduz o efeito"]
