    {
      "name": "The Fear-Avoidance Cycle",
      "char_file": "운동화_illust.jpg",
      "body": [
        "1 in 4 adults over 65",
        "falls every year (CDC)",
        "",
        "Doctors now screen for fear-driven",
        "inactivity, not just leg strength"
      ]
    },
    {
      "name": "Add Balance + Strength Training",
      "char_file": "운동화_illust.jpg",
      "body": [
        "Combined balance and",
        "resistance training cuts falls",
        "up to 34%",
        "",
        "Try single-leg stands or",
        "sit-to-stand repeats, 2-3x a week"
      ]
    },
    {
      "name": "Home Is Riskier Than Outside",
      "char_file": "욕조_illust.jpg",
      "body": [
        "Most falls happen at home,",
        "not outside",
        "",
        "Loose rugs, dim lighting, and",
        "socks or backless slippers are common triggers"
      ]
    },
    {
      "name": "Secure Rugs, Add Grab Bars",
      "char_file": "욕조_illust.jpg",
      "body": [
        "Secure loose rugs and",
        "add bathroom grab bars",
        "",
        "Switch to shoes with",
        "real tread, even indoors"
      ]
    },
    {
      "name": "4+ Medications Raise Your Risk",
      "char_file": "알약_illust.jpg",
      "body": [
        "Sedatives and some",
