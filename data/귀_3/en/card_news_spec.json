  "items": [
    {
      "name": "Why this happens",
      "char_file": "휴지_illust.jpg",
      "body": [
        "Your Eustachian tube links",
        "your middle ear to your throat",
        "",
        "When it stays blocked, fluid",
        "pools and bacteria move in"
      ]
    },
    {
      "name": "Untreated colds",
      "char_file": "휴지_illust.jpg",
      "body": [
        "Riding out a cold or sinus",
        "infection keeps the tube blocked",
        "",
        "The longer inflammation lingers,",
        "the more fluid collects behind your eardrum"
      ]
    },
    {
      "name": "Treat it early",
      "char_file": "휴지_illust.jpg",
      "body": [
        "Treat colds and sinus",
        "symptoms early, don't wait it out",
        "",
        "Clearing inflammation fast keeps",
        "your Eustachian tube open"
      ]
    },
    {
      "name": "Flight pressure",
      "char_file": "비행기_illust.jpg",
      "body": [
        "Skipping swallowing or yawning",
        "during takeoff and landing",
        "",
        "Fast pressure shifts pull fluid",
        "into your middle ear"
      ]
    },
    {
      "name": "Swallow and chew",
      "char_file": "비행기_illust.jpg",
      "body": [
        "Chew gum or swallow often",
        "during takeoff and landing",
        "",
        "It opens your Eustachian tube",
        "so pressure equalizes safely"
      ]
    },
    {
      "name": "Smoke exposure",
      "char_file": "담배_illust.jpg",
      "body": [
        "Regular cigarette smoke, direct",
        "or secondhand, damages tiny cilia",
        "",
        "Those cilia normally sweep fluid",
        "out of your Eustachian tube"
      ]
    },
    {
      "name": "Avoid smoke",
      "char_file": "담배_illust.jpg",
      "body": [
        "Keep your distance from smoke,",
        "yours or someone else's",
        "",
        "Protecting your cilia keeps",
        "fluid draining like it should"
      ]
    }
  ],
  "closing": {
    "headline": [
      [
        "Ear infections aren't just",
        "a kids' problem"
      ],
      [
        "A blocked Eustachian tube is",
        "usually the real cause"
      ]
    ],
    "tip": [
      "Treat colds early, equalize on flights,",
