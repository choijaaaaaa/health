  "items": [
    {
      "name": "Why does this happen",
      "char_file": "손가락_illust.jpg",
      "body": [
        "Bacteria or viruses reach",
        "the conjunctiva - the membrane",
        "covering your eye",
        "",
        "That's when it turns red,",
        "itchy, and starts producing discharge"
      ]
    },
    {
      "name": "Touching your eyes",
      "char_file": "손가락_illust.jpg",
      "body": [
        "Discharge on your fingers",
        "goes right back into your eyes",
        "",
        "Rubbing keeps the infection",
        "circulating instead of clearing up"
      ]
    },
    {
      "name": "Wash before you touch",
      "char_file": "손가락_illust.jpg",
      "body": [
        "Wash your hands before",
        "you touch your eyes",
        "",
        "A simple habit that closes",
        "off this one pathway of spread"
      ]
    },
    {
      "name": "Sleeping in contact lenses",
      "char_file": "콘택트렌즈_illust.jpg",
      "body": [
        "A closed eyelid traps",
        "bacteria against the cornea",
        "",
        "Rinsing lenses in tap water",
        "instead of solution adds more risk"
      ]
    },
    {
      "name": "Give your lenses proper care",
      "char_file": "콘택트렌즈_illust.jpg",
      "body": [
        "Remove contacts before bed,",
        "every single night",
        "",
        "Clean them with proper solution -",
        "never tap water"
      ]
    },
    {
      "name": "Sharing towels or pillowcases",
      "char_file": "수건_illust.jpg",
      "body": [
        "The virus survives on fabric",
        "long enough to pass along",
        "",
        "Sharing with someone infected",
        "makes transmission far more likely"
      ]
    },
    {
      "name": "Keep towels to yourself",
      "char_file": "수건_illust.jpg",
      "body": [
        "Keep towels and pillowcases",
        "separate until symptoms clear",
        "",
        "One more pathway closed,",
        "one less way it spreads"
      ]
    }
