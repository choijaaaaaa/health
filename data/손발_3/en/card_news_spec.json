  "items": [
    {
      "name": "Why does this happen",
      "char_file": "스마트폰_illust.jpg",
      "body": [
        "Tingling and aching in your",
        "wrist and fingers?",
        "",
        "The tunnel around your median",
        "nerve gets squeezed - these three",
        "habits are the biggest culprits"
      ]
    },
    {
      "name": "Phone with a bent wrist",
      "char_file": "스마트폰_illust.jpg",
      "body": [
        "First, holding your phone with",
        "your wrist bent for long stretches",
        "",
        "Every extra hour of smartphone",
        "use raises carpal tunnel risk"
      ]
    },
    {
      "name": "Straighten up & stretch",
      "char_file": "스마트폰_illust.jpg",
      "body": [
        "Keep your wrist straight",
        "when you hold your phone",
        "",
        "Stretch it out every",
        "20 to 30 minutes"
      ]
    },
    {
      "name": "Keyboard & mouse without support",
      "char_file": "서류더미_illust.jpg",
      "body": [
        "Second, typing or using a mouse",
        "without any wrist support",
        "",
        "Bending your wrist up or sideways",
        "keeps steady pressure on the nerve"
      ]
    },
    {
      "name": "Add a wrist rest",
      "char_file": "서류더미_illust.jpg",
      "body": [
        "Add a wrist rest",
        "to your keyboard and mouse",
        "",
        "Keeping your wrist neutral",
        "eases the pressure"
      ]
    },
    {
      "name": "Sleeping with a bent wrist",
      "char_file": "베개_illust.jpg",
      "body": [
        "Finally, sleeping with your",
        "wrist curled under your pillow",
        "",
        "Blood flow slows at night, so that",
        "bent position squeezes the nerve even harder"
      ]
    },
    {
      "name": "Wear a splint at night",
      "char_file": "베개_illust.jpg",
      "body": [
        "Wear a wrist splint at",
        "night to keep your wrist neutral",
        "",
        "It stops your wrist from",
        "curling while you sleep"
      ]
    }
  ],
