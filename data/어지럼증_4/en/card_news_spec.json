{
  "title": [
    "Your legs won't stop moving at night?",
    "It might not be restlessness —",
    "it could be low iron"
  ],
  "eyebrow": "Low Iron Warning",
  "topic_word": "Anemia",
  "swipe_label": "Swipe to see more  →",
  "closing_label": "Recap",
  "char_display_names": {
    "아스피린_illust.jpg": "Acid Reducers",
    "영양제_illust.jpg": "Zinc Supplements",
    "와인_illust.jpg": "Red Wine"
  },
  "items": [
    {
      "name": "Why This Happens",
      "char_file": "아스피린_illust.jpg",
      "body": [
        "Restless legs at night affect",
        "nearly 1 in 10 American adults",
        "",
        "Low iron is one of the most",
        "common triggers behind it"
      ]
    },
    {
      "name": "Acid Reducers",
      "char_file": "아스피린_illust.jpg",
      "body": [
        "Omeprazole and other acid",
        "reducers lower stomach acid",
        "",
        "That acid is what turns iron",
        "into a form your body can absorb"
      ]
    },
    {
      "name": "Acid Reducers: Do This",
      "char_file": "아스피린_illust.jpg",
      "body": [
        "Ask your doctor before",
        "stopping any medication",
        "",
        "Pairing meals with vitamin C",
        "can help offset the drop"
      ]
    },
    {
      "name": "Zinc Supplements",
      "char_file": "영양제_illust.jpg",
      "body": [
        "Zinc taken with iron competes",
        "for the same absorption pathway",
        "",
        "That can cut iron absorption",
        "by 30 to over 50%"
      ]
    },
    {
      "name": "Zinc: Do This",
      "char_file": "영양제_illust.jpg",
      "body": [
        "Space zinc supplements at least",
        "2 hours from iron-rich meals",
        "",
        "Take them at a different time,",
        "not together"
      ]
    },
    {
      "name": "Red Wine",
      "char_file": "와인_illust.jpg",
      "body": [
        "Red wine's polyphenols bind",
        "to the iron in your food",
        "",
        "That cuts absorption",
        "by about 28%"
      ]
    },
    {
      "name": "Red Wine: Do This",
      "char_file": "와인_illust.jpg",
      "body": [
        "Wait about an hour after eating",
        "before having a glass",
        "",
        "That gap keeps iron",
        "absorption on track"
      ]
    }
  ],
  "closing": {
    "headline": [
      [
        "Low iron isn't always obvious —",
        "restless legs can be a clue"
      ],
      [
        "You don't have to cut anything out —",
        "just space things out"
      ]
    ],
    "tip": [
      "Pair iron with vitamin C if you're on",
      "acid reducers; space zinc & wine from iron"
    ],
    "cta": "Want more health tips? Subscribe and follow for more!"
  }
}
