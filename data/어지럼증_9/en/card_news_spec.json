  "items": [
    {
      "name": "Why This Isn't Just Ordinary Dizziness",
      "char_file": "물방울_illust.jpg",
      "body": [
        "Unlike BPPV or vestibular",
        "neuritis, Ménière's brings",
        "",
        "vertigo, tinnitus, hearing",
        "changes, and ear fullness",
        "all together",
        "",
        "Attacks last 20 minutes",
        "to several hours"
      ]
    },
    {
      "name": "First, Sodium Fuels Attacks",
      "char_file": "소금_illust.jpg",
      "body": [
        "Extra salt makes your",
        "body retain fluid",
        "",
        "That raises pressure in the",
        "already fluid-overloaded",
        "inner ear",
        "",
        "This worsens endolymphatic",
        "hydrops and triggers attacks"
      ]
    },
    {
      "name": "Cut Sodium Like This",
      "char_file": "소금_illust.jpg",
      "body": [
        "Keep sodium under 1,500",
        "to 2,000 mg a day",
        "",
        "Swap canned and",
        "processed foods",
        "",
        "for fresh ingredients",
        "you season yourself"
      ]
    },
    {
      "name": "Second, Caffeine and Alcohol",
      "char_file": "커피_illust.jpg",
      "body": [
        "Caffeine constricts vessels",
        "and cuts inner ear blood flow",
        "",
        "Alcohol diffuses into inner",
        "ear fluid and disrupts",
        "its balance directly"
      ]
    },
    {
      "name": "Cut Back Like This",
      "char_file": "커피_illust.jpg",
      "body": [
        "Swap coffee for decaf",
        "or herbal tea",
        "",
        "Reach for sparkling water",
        "instead of a second drink"
      ]
    },
    {
      "name": "Third, Stress and Poor Sleep",
      "char_file": "긴장_illust.jpg",
      "body": [
        "Disrupted nervous system",
        "signals hurt blood flow",
        "",
        "and fluid balance",
        "in the inner ear",
        "",
        "Irregular sleep shortens",
        "the gap between attacks"
      ]
    },
    {
      "name": "Manage It Like This",
      "char_file": "긴장_illust.jpg",
      "body": [
        "Keep a consistent",
        "sleep schedule",
        "",
        "Swap your phone before bed",
        "for light stretching to unwind"
      ]
    }
  ],
  "closing": {
    "headline": [
      ["If vertigo keeps coming", "with ringing ears or hearing changes"],
