  "items": [
    {
      "name": "Why this happens",
      "char_file": "흰빵_illust.jpg",
      "body": [
        "Leg veins have to push",
        "blood all the way",
        "back up to your heart",
        "",
        "Some foods add fluid volume",
        "or strain the vessel walls"
      ]
    },
    {
      "name": "White Bread",
      "char_file": "흰빵_illust.jpg",
      "body": [
        "Low-fiber refined carbs",
        "make constipation",
        "more likely",
        "",
        "Straining spikes abdominal",
        "pressure, pushing down",
        "on leg veins"
      ]
    },
    {
      "name": "White Bread — the fix",
      "char_file": "흰빵_illust.jpg",
      "body": [
        "Trade white bread for",
        "whole grains or oats"
      ]
    },
    {
      "name": "Salty Processed Food",
      "char_file": "패스트푸드_illust.jpg",
      "body": [
        "Deli meats, frozen pizza,",
        "and fast food are loaded",
        "with sodium",
        "",
        "Sodium makes your body hold",
        "extra water, raising blood",
        "volume and vein pressure"
      ]
    },
    {
      "name": "Salty Food — the fix",
      "char_file": "패스트푸드_illust.jpg",
      "body": [
        "Swap for freshly",
        "cooked meat at home"
      ]
    },
    {
      "name": "Wine & Alcohol",
      "char_file": "와인_illust.jpg",
      "body": [
        "Dilates blood vessels while",
        "dehydrating you at the",
        "same time",
        "",
        "Can weaken your veins'",
        "ability to push blood",
        "back up"
      ]
    },
    {
      "name": "Alcohol — the fix",
      "char_file": "와인_illust.jpg",
      "body": [
        "Swap wine for sparkling",
        "water some nights"
      ]
    }
  ],
  "closing": {
    "headline": [
      [
        "White bread, deli meats, and wine",
        "don't need to disappear for good"
      ],
      [
        "Trading them out helps",
        "your legs feel a lot lighter"
      ]
    ],
    "tip": [
