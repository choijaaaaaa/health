{
  "title": [
    "Taking allergy medicine daily",
    "but still waking up mouth-breathing?",
    "Foods That Make Rhinitis Worse"
  ],
  "eyebrow": "Rhinitis Alert",
  "cover_char_file": "우유_illust.jpg",
  "char_display_names": {
    "우유_illust.jpg": "Dairy",
