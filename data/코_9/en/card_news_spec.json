  "items": [
    {
      "name": "Why nasal tissue dries out",
      "char_file": "물방울_illust.jpg",
      "body": [
        "Nasal tissue needs constant",
        "moisture to stay flexible",
        "",
        "When it dries out it cracks,",
        "crusts, and bleeds easily"
      ]
    },
    {
      "name": "CPAP without enough humidity",
      "char_file": "양압기_illust.jpg",
      "body": [
        "Constant pressurized airflow",
        "strips moisture from the lining",
        "",
        "all night long"
      ]
    },
    {
      "name": "Fix: CPAP",
      "char_file": "양압기_illust.jpg",
      "body": [
        "Turn on your machine's",
        "heated humidifier",
        "and raise the setting"
      ]
    },
    {
      "name": "Frequent air travel",
      "char_file": "비행기_illust.jpg",
      "body": [
        "Cabin air holds as little as",
        "10 to 20% humidity",
        "",
        "far drier than any room",
        "on the ground"
      ]
    },
    {
      "name": "Fix: flying",
      "char_file": "비행기_illust.jpg",
      "body": [
        "Use a saline nasal spray",
        "before boarding and again",
        "during long flights"
      ]
    },
    {
      "name": "Forced-air furnace heating",
      "char_file": "라디에이터_illust.jpg",
      "body": [
        "Winter indoor humidity can",
        "drop to 15 to 25%",
        "",
        "well below what nasal",
        "tissue needs"
      ]
    },
    {
      "name": "Fix: home heating",
      "char_file": "라디에이터_illust.jpg",
      "body": [
        "Run a humidifier near your bed,",
        "within a few feet",
        "so the moisture reaches you"
      ]
    }
  ],
  "closing": {
    "headline": [
