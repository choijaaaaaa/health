    "휴지_illust.jpg": "Blowing Your Nose"
  },
  "items": [
    {
      "name": "Why does this happen",
      "char_file": "알약_illust.jpg",
      "body": [
        "About 60% of Americans get",
        "a nosebleed at some point",
        "",
        "If yours keep coming back,",
        "allergy medication, frequent flying,",
        "and blowing your nose too hard",
        "could be why"
      ]
    },
    {
      "name": "Allergy Medication",
      "char_file": "알약_illust.jpg",
      "body": [
        "Antihistamines and decongestants",
        "dry out your nasal lining",
        "",
        "Once it's dry and stiff,",
        "it cracks and bleeds more easily"
      ]
    },
    {
      "name": "Try this instead",
      "char_file": "알약_illust.jpg",
      "body": [
        "If allergy medication seems",
        "to be drying you out,",
        "",
        "ask your doctor about",
        "a lower dose or a different option"
      ]
    },
    {
      "name": "Airplane Cabin Air",
      "char_file": "기압_illust.jpg",
      "body": [
        "Airplane cabins run",
        "far drier than a normal room",
        "",
        "Pressure changes on takeoff",
        "and landing add extra strain",
        "on those vessels"
      ]
    },
    {
      "name": "Try this instead",
      "char_file": "기압_illust.jpg",
      "body": [
        "Use a saline spray",
        "before and during flights",
        "",
        "It helps keep the",
        "lining from drying out"
      ]
    },
    {
      "name": "Blowing Too Hard",
      "char_file": "휴지_illust.jpg",
      "body": [
        "Blowing hard during a cold",
        "or allergy flare",
        "",
        "puts pressure right where",
        "most nosebleeds start"
      ]
    },
    {
      "name": "Try this instead",
      "char_file": "휴지_illust.jpg",
      "body": [
        "Blow gently,",
        "one side at a time"
      ]
    }
  ],
  "closing": {
    "headline": [
      [
        "Allergy meds, cabin air, hard blowing -",
        "small changes make a difference"
      ],
      [
        "and can cut down",
        "how often it happens"
      ]
    ],
    "tip": [
      "See a doctor if bleeding lasts over 10 minutes",
      "or keeps coming back"
    ],
    "cta": "Want more health tips like this? Subscribe, like, and follow!"
  }
