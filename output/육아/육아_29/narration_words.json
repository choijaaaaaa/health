[{"text": "노로바이러스,", "start": 0.2, "end": 0.82}, {"text": "아이가", "start": 1.32, "end": 1.54}, {"text": "토한", "start": 1.62, "end": 1.86}, {"text": "걸", "start": 1.92, "end": 2.02}, {"text": "치우고", "start": 2.08, "end": 2.48}, {"text": "손소독제만", "start": 2.64, "end": 3.34}, {"text": "쓱", "start": 3.42, "end": 3.62}, {"text": "바르고", "start": 3.68, "end": 3.94}, {"text": "계신가요?", "start": 4.0, "end": 4.44}, {"text": "노로바이러스는", "start": 5.019, "end": 5.739}, {"text": "손소독제로", "start": 5.899, "end": 6.439}, {"text": "잘", "start": 6.499, "end": 6.619}, {"text": "없어지지", "start": 6.679, "end": 7.059}, {"text": "않아요.", "start": 7.119, "end": 7.399}, {"text": "미국", "start": 8.119, "end": 8.359}, {"text": "질병통제예방센터도", "start": 8.419, "end": 9.639}, {"text": "손소독제로는", "start": 9.979, "end": 10.779}, {"text": "비누", "start": 11.139, "end": 11.359}, {"text": "손씻기를", "start": 11.419, "end": 11.859}, {"text": "대신할", "start": 11.919, "end": 12.219}, {"text": "수", "start": 12.279, "end": 12.319}, {"text": "없다고", "start": 12.379, "end": 12.679}, {"text": "해요.", "start": 12.739, "end": 12.899}, {"text": "실제로", "start": 13.599, "end": 13.919}, {"text": "손에", "start": 13.979, "end": 14.139}, {"text": "노로바이러스를", "start": 14.199, "end": 14.838}, {"text": "묻혀", "start": 14.898, "end": 15.138}, {"text": "시험해", "start": 15.198, "end": 15.458}, {"text": "보니,", "start": 15.518, "end": 15.738}, {"text": "손소독제는", "start": 16.378, "end": 17.058}, {"text": "바이러스를", "start": 17.138, "end": 17.678}, {"text": "절반", "start": 17.758, "end": 18.018}, {"text": "정도밖에", "start": 18.118, "end": 18.518}, {"text": "못", "start": 18.578, "end": 18.638}, {"text": "줄였어요.", "start": 18.698, "end": 19.118}, {"text": "비누로", "start": 19.798, "end": 20.098}, {"text": "씻었을", "start": 20.158, "end": 20.498}, {"text": "땐", "start": 20.558, "end": 20.718}, {"text": "최대", "start": 20.798, "end": 21.038}, {"text": "구십사", "start": 21.098, "end": 21.458}, {"text": "퍼센트까지", "start": 21.538, "end": 22.038}, {"text": "줄었고요.", "star